# Firebase web app configuration (Project settings → General → Your apps → SDK setup and configuration).
# Copy this file to .env and fill in the values from your Firebase project.
# All values are public client-side identifiers — they are safe to expose in the bundle,
# but access is protected by Firebase Auth settings and OAuth consent configuration.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
